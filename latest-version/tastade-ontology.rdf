     -->

    


    <!-- http://data.tastade.org/ontology/addressAsWritten -->

    <owl:DatatypeProperty rdf:about="http://data.tastade.org/ontology/addressAsWritten">
        <rdfs:domain rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E53_Place"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>address as written</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://data.tastade.org/ontology/cloudFolderUrl -->

    <owl:DatatypeProperty rdf:about="http://data.tastade.org/ontology/cloudFolderUrl">
        <rdfs:domain rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E31_Document"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://schema.org/url</rdfs:isDefinedBy>
        <rdfs:label>cloud folder url</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://data.tastade.org/ontology/interestRate -->

    <owl:DatatypeProperty rdf:about="http://data.tastade.org/ontology/interestRate">
        <rdfs:domain rdf:resource="http://data.tastade.org/ontology/Loan"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">The interest rate as a decimal (e.g., 0.05 for 5%).</rdfs:comment>
        <rdfs:label xml:lang="en">interest rate</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://data.tastade.org/ontology/loanTerms -->

    <owl:DatatypeProperty rdf:about="http://data.tastade.org/ontology/loanTerms">
        <rdfs:domain rdf:resource="http://data.tastade.org/ontology/Loan"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
        <rdfs:comment xml:lang="en">Details of the loan terms, as free text.</rdfs:comment>
        <rdfs:label xml:lang="en">loan terms</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://data.tastade.org/ontology/locator -->

    <owl:DatatypeProperty rdf:about="http://data.tastade.org/ontology/locator">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E1_CRM_Entity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>locator</rdfs:label>
        <schema:sameAs>http://purl.org/ontology/bibo/locator</schema:sameAs>
    </owl:DatatypeProperty>
    


    <!-- http://data.tastade.org/ontology/pageScanUrl -->

    <owl:DatatypeProperty rdf:about="http://data.tastade.org/ontology/pageScanUrl">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E31_Document"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:isDefinedBy>https://schema.org/url</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">page scan url</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://data.tastade.org/ontology/shareFractionalValue -->

    <owl:DatatypeProperty rdf:about="http://data.tastade.org/ontology/shareFractionalValue">
        <rdfs:domain rdf:resource="http://data.tastade.org/ontology/Share"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The fraction of the underlying asset that this share represents (e.g., &apos;1/16&apos;, &apos;1/64&apos;, &apos;1/100&apos;). Stored as a string to accommodate non-decimal historical fractional notations.</rdfs:comment>
        <rdfs:label xml:lang="en">share fractional value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://data.tastade.org/ontology/sterlingEquivalentvalue -->

    <owl:DatatypeProperty rdf:about="http://data.tastade.org/ontology/sterlingEquivalentvalue">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P90_has_value"/>
        <rdfs:domain rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E97_Monetary_Amount"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">The monetary value converted to £-sterling for comparative analysis across currencies and periods. Calculated based on historical exchange rates at the time of the transaction.</rdfs:comment>
        <rdfs:label xml:lang="en">sterling equivalent value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://data.tastade.org/ontology/zoteroItemUrl -->

    <owl:DatatypeProperty rdf:about="http://data.tastade.org/ontology/zoteroItemUrl">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E31_Document"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment xml:lang="en">URL of the corresponding item in the project&apos;s Zotero group library, where full bibliographic metadata is maintained and where the project adds the links to the archived copies.</rdfs:comment>
        <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://schema.org/url</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">zotero item url</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.w3.org/2002/07/owl#topDataProperty -->

    <rdf:Description rdf:about="http://www.w3.org/2002/07/owl#topDataProperty">
        <rdfs:domain rdf:resource="http://data.tastade.org/ontology/Residence"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The specific street address or location within a place, as recorded in the source. Preserved verbatim; not linked to a structured Place entity in this version.</rdfs:comment>
    </rdf:Description>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://data.tastade.org/ontology/ActorActivity -->

    <owl:Class rdf:about="http://data.tastade.org/ontology/ActorActivity">
        <rdfs:subClassOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E7_Activity"/>
        <rdfs:comment xml:lang="en">A significant activity in a person&apos;s life or in an organisation&apos;s life too. This is a temporal entity with a time-span, and typically involves the actor as its subject.</rdfs:comment>
        <rdfs:label xml:lang="en">Actor Activity</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://personsincontext.org/model/#LifeEvent</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://data.tastade.org/ontology/BinaryRelationship -->

    <owl:Class rdf:about="http://data.tastade.org/ontology/BinaryRelationship">
        <rdfs:subClassOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E2_Temporal_Entity"/>
        <rdfs:comment xml:lang="en">A documented binary relationship between two entities.</rdfs:comment>
        <rdfs:label xml:lang="en">Binary-Relationship</rdfs:label>
    </owl:Class>
    


    <!-- http://data.tastade.org/ontology/BottomryLoan -->

    <owl:Class rdf:about="http://data.tastade.org/ontology/BottomryLoan">
        <rdfs:subClassOf rdf:resource="http://data.tastade.org/ontology/Loan"/>
        <rdfs:comment xml:lang="en">(Financial instrument). A maritime loan in which money is advanced for the outfitting or operation of a voyage, secured against the ship; repaid with interest on safe completion of the voyage, but forfeited if the ship is lost.</rdfs:comment>
        <rdfs:label xml:lang="en">Bottomry Loan</rdfs:label>
    </owl:Class>
    


    <!-- http://data.tastade.org/ontology/Crossing -->

    <owl:Class rdf:about="http://data.tastade.org/ontology/Crossing">
        <rdfs:subClassOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E7_Activity"/>
        <rdfs:comment xml:lang="en">SeaLit definition: &quot;This class comprises information about the voyages of ships. Voyage is defined as the process of travelling from one place to another, staying there, usually for a short time; it is not a simple move/change from place to place; it is a movement in space and time (and it is documented as that [1] ). The same ship can sail many voyages during its lifetime. Voyage and route information is very important for historically investigating the various trade routes and navigation patterns used to exist in different times. Voyage is an important aspect of the ship and the seaman, and generally of the seafaring life, both at sea and ashore .&quot;</rdfs:comment>
        <rdfs:isDefinedBy xml:lang="en">http://www.sealitproject.eu/ontology/Voyage</rdfs:isDefinedBy>
        <rdfs:label>Crossing</rdfs:label>
        <skos:altLabel xml:lang="en">Voyage</skos:altLabel>
    </owl:Class>
    


    <!-- http://data.tastade.org/ontology/DebtPayment -->

    <owl:Class rdf:about="http://data.tastade.org/ontology/DebtPayment">
        <rdfs:subClassOf rdf:resource="http://data.tastade.org/ontology/FinancialActivity"/>
        <rdfs:label>Debt Payment</rdfs:label>
    </owl:Class>
    


    <!-- http://data.tastade.org/ontology/DividendPayment -->

    <owl:Class rdf:about="http://data.tastade.org/ontology/DividendPayment">
        <rdfs:subClassOf rdf:resource="http://data.tastade.org/ontology/FinancialActivity"/>
        <rdfs:comment xml:lang="en">A binary relationship to register profit distribution. It has two main parties — the payer (the company paying the dividend) and the recipient (the shareholder (Actor) receiving it)</rdfs:comment>
        <rdfs:label xml:lang="en">Dividend Payment</rdfs:label>
    </owl:Class>
    


    <!-- http://data.tastade.org/ontology/EconomicActivity -->

    <owl:Class rdf:about="http://data.tastade.org/ontology/EconomicActivity">
        <rdfs:subClassOf rdf:resource="http://data.tastade.org/ontology/ActorActivity"/>
        <rdfs:comment xml:lang="en">Mostly used to describe the economic sector in which a Group (organisation) is involved. 
It can also be used for a Person, but only when there is an emphasis on the economic/business aspect. Example: Person X is in the textile business for a specific period of time (notice the difference with Occupation, which should only be used for a Person, to describe a job title). Here two examples to distinguish when to use this class for a Person:
Example 1: 
- Occupation: Person X is a merchant (their professional role, social status)
- Economic Activity: Person X is in the textile business (participates in the textile sector as a business venture)
Example 2:
- Occupation: Person X is a sea captain (professional role)
- Economic Activity: Person X is in the shipping business or overseas trade (participates in that commercial sector)
Captain is an occupation, but the person&apos;s business involvement (shipping enterprise, cargo trading) is the economic activity.
The two can be complementary: a person may have an Occupation as &apos;merchant&apos; 
and simultaneously an Economic Activity in the &apos;textile business.&apos;
Note: Enter only what is described in the observation.</rdfs:comment>
        <rdfs:label xml:lang="en">Economic Activity</rdfs:label>
    </owl:Class>
    


    <!-- http://data.tastade.org/ontology/EconomicSectorType -->

    <owl:Class rdf:about="http://data.tastade.org/ontology/EconomicSectorType">
        <rdfs:subClassOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E55_Type"/>
        <rdfs:label>Economic Sector Type</rdfs:label>
    </owl:Class>
    


    <!-- http://data.tastade.org/ontology/EmploymentRelationship -->

    <owl:Class rdf:about="http://data.tastade.org/ontology/EmploymentRelationship">
        <rdfs:subClassOf rdf:resource="http://data.tastade.org/ontology/MembershipRelationship"/>
        <rdfs:label xml:lang="en">Employment-Relationship</rdfs:label>
    </owl:Class>
    


    <!-- http://data.tastade.org/ontology/EnslavedPersonOwnership -->

    <owl:Class rdf:about="http://data.tastade.org/ontology/EnslavedPersonOwnership">
        <rdfs:subClassOf rdf:resource="http://data.tastade.org/ontology/Ownership"/>
        <rdfs:comment xml:lang="en">Historical relationship of chattel slavery. Note: the &apos;owned&apos; entity is a Person (crm:E21_Person), not a Legal Object. This pattern documents historical reality where persons were legally treated as property, without endorsing that treatment.</rdfs:comment>
        <rdfs:label xml:lang="en">Enslaved Person Ownership</rdfs:label>
    </owl:Class>
    


    <!-- http://data.tastade.org/ontology/FamilyRelationship -->

    <owl:Class rdf:about="http://data.tastade.org/ontology/FamilyRelationship">
        <rdfs:subClassOf rdf:resource="http://data.tastade.org/ontology/PersonRelationship"/>
        <rdfs:comment xml:lang="en">A kinship relationship between two persons, including biological, adoptive, in-law, step-, and similar relations.</rdfs:comment>
        <rdfs:label xml:lang="en">Family-Relationship</rdfs:label>
    </owl:Class>
    


    <!-- http://data.tastade.org/ontology/FamilyRelationshipType -->

    <owl:Class rdf:about="http://data.tastade.org/ontology/FamilyRelationshipType">
        <rdfs:subClassOf rdf:resource="http://data.tastade.org/ontology/RelationType"/>
        <rdfs:label xml:lang="en">Family Relationship Type</rdfs:label>
    </owl:Class>
    


    <!-- http://data.tastade.org/ontology/FinancialActivity -->

    <owl:Class rdf:about="http://data.tastade.org/ontology/FinancialActivity">
        <rdfs:subClassOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E7_Activity"/>
        <rdfs:comment>An event or activity involving financial transactions, payments, or transfers between actors.</rdfs:comment>
        <rdfs:label>Financial Activity</rdfs:label>
        <skos:scopeNote xml:lang="en">Includes recurring financial events that can happen multiple times over a financial instrument&apos;s lifetime: 
 - Payments (DebtPayment, DividendPayment)
 - Transfers (ShareTransfer)
 - Potentially: interest payments, capital calls, loan repayments, defaults         
Excludes single-occurrence &apos;creation&apos; events (like loan origination or share issuance) which are captured via date properties on the instrument itself (e.g., ont:loanOriginationDate) rather than as separate event classes. This avoids redundancy while preserving essential temporal information.</skos:scopeNote>
    </owl:Class>
    


    <!-- http://data.tastade.org/ontology/FinancialInstrument -->

    <owl:Class rdf:about="http://data.tastade.org/ontology/FinancialInstrument">
        <rdfs:subClassOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E72_Legal_Object"/>
        <rdfs:comment>A legal object representing a financial claim, obligation, or ownership stake. Financial instruments can be owned, transferred, and typically have a monetary value expressed in a specific currency.
Currently (August 24, 2026) it includes Loans (debt instruments) and Shares (equity instruments). May be extended to include other instruments like Bills of Exchange, Bonds, or Insurance Policies as research demands.</rdfs:comment>
        <rdfs:label xml:lang="en">Financial Instrument</rdfs:label>
    </owl:Class>
    


    <!-- http://data.tastade.org/ontology/FinancialInstrumentOwnership -->

    <owl:Class rdf:about="http://data.tastade.org/ontology/FinancialInstrumentOwnership">
        <rdfs:subClassOf rdf:resource="http://data.tastade.org/ontology/Ownership"/>
        <rdfs:label>Financial Instrument-Ownership</rdfs:label>
    </owl:Class>
    


    <!-- http://data.tastade.org/ontology/GenderType -->

    <owl:Class rdf:about="http://data.tastade.org/ontology/GenderType">
        <rdfs:subClassOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E55_Type"/>
        <rdfs:label xml:lang="en">Gender Type</rdfs:label>
    </owl:Class>
    


    <!-- http://data.tastade.org/ontology/GroupRelationship -->

    <owl:Class rdf:about="http://data.tastade.org/ontology/GroupRelationship">
        <rdfs:subClassOf rdf:resource="http://data.tastade.org/ontology/BinaryRelationship"/>
        <rdfs:comment xml:lang="en">A relationship between a person and a group, such as membership in an organization, employment, or affiliation.</rdfs:comment>
        <rdfs:label xml:lang="en">Group-Relationship</rdfs:label>
    </owl:Class>
    


    <!-- http://data.tastade.org/ontology/GroupRelationshipType -->

    <owl:Class rdf:about="http://data.tastade.org/ontology/GroupRelationshipType">
        <rdfs:subClassOf rdf:resource="http://data.tastade.org/ontology/RelationType"/>
        <rdfs:label xml:lang="en">Group Relationship Type</rdfs:label>
    </owl:Class>
    


    <!-- http://data.tastade.org/ontology/GroupType -->

    <owl:Class rdf:about="http://data.tastade.org/ontology/GroupType">
        <rdfs:subClassOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E55_Type"/>
        <rdfs:label>Group Type</rdfs:label>
    </owl:Class>
    


    <!-- http://data.tastade.org/ontology/IdentifierType -->

    <owl:Class rdf:about="http://data.tastade.org/ontology/IdentifierType">
        <rdfs:subClassOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E55_Type"/>
        <rdfs:comment xml:lang="en">The scheme or source of an external identifier assigned to an entity.</rdfs:comment>
        <rdfs:label xml:lang="en">Identifier Type</rdfs:label>
    </owl:Class>
    


    <!-- http://data.tastade.org/ontology/IntergroupRelationship -->

    <owl:Class rdf:about="http://data.tastade.org/ontology/IntergroupRelationship">
        <rdfs:subClassOf rdf:resource="http://data.tastade.org/ontology/BinaryRelationship"/>
        <rdfs:comment xml:lang="en">A relationship between two groups, such as parent-subsidiary, partnership, or commercial alliance.</rdfs:comment>
        <rdfs:label xml:lang="en">Intergroup-Relationship</rdfs:label>
    </owl:Class>
    


    <!-- http://data.tastade.org/ontology/Loan -->

    <owl:Class rdf:about="http://data.tastade.org/ontology/Loan">
        <rdfs:subClassOf rdf:resource="http://data.tastade.org/ontology/FinancialInstrument"/>
        <rdfs:comment xml:lang="en">Formal loan (= debt obligation) instrument with terms.</rdfs:comment>
        <rdfs:label xml:lang="en">Loan</rdfs:label>
    </owl:Class>
    


    <!-- http://data.tastade.org/ontology/LoanOwnership -->

    <owl:Class rdf:about="http://data.tastade.org/ontology/LoanOwnership">
        <rdfs:subClassOf rdf:resource="http://data.tastade.org/ontology/FinancialInstrumentOwnership"/>
        <rdfs:comment xml:lang="en">Represents the creditor&apos;s ownership of a loan as a legal asset. The creditor holds the loan; the debtor is obligated per the loan&apos;s terms.</rdfs:comment>
        <rdfs:label>Loan Ownership</rdfs:label>
    </owl:Class>
    


    <!-- http://data.tastade.org/ontology/LoanType -->

    <owl:Class rdf:about="http://data.tastade.org/ontology/LoanType">
        <rdfs:subClassOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E55_Type"/>
        <rdfs:label xml:lang="en">Loan Type</rdfs:label>
    </owl:Class>
    


    <!-- http://data.tastade.org/ontology/MembershipRelationship -->

    <owl:Class rdf:about="http://data.tastade.org/ontology/MembershipRelationship">
        <rdfs:subClassOf rdf:resource="http://data.tastade.org/ontology/GroupRelationship"/>
        <rdfs:comment xml:lang="en">A specific kind of group relationship expressing a person&apos;s belonging to a group. Abstract parent for specific kinds of membership.</rdfs:comment>
        <rdfs:label xml:lang="en">Membership-Relationship</rdfs:label>
        <skos:scopeNote>Use subclasses to distinguish specific kinds of membership when relevant (OrganizationalMembership, ReligiousMembership, CivicMembership). The generic Membership class can be used when the type is not further specified or when the group&apos;s own type is sufficient to convey the nature of belonging.</skos:scopeNote>
    </owl:Class>
    


    <!-- http://data.tastade.org/ontology/Occupation -->

    <owl:Class rdf:about="http://data.tastade.org/ontology/Occupation">
        <rdfs:subClassOf rdf:resource="http://data.tastade.org/ontology/ActorActivity"/>
        <rdfs:comment xml:lang="en">The activity of holding a specific occupation, role, or profession for a period of time.
Tastade partially complies with PiCo&apos;s direct property for occupation: https://schema.org/hasOccupation (The occupational title related to a person in an observation.)</rdfs:comment>
        <rdfs:label xml:lang="en">Occupation</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://schema.org/hasOccupation</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://data.tastade.org/ontology/OrganizationalMembership -->

    <owl:Class rdf:about="http://data.tastade.org/ontology/OrganizationalMembership">
        <rdfs:subClassOf rdf:resource="http://data.tastade.org/ontology/MembershipRelationship"/>
        <owl:disjointWith rdf:resource="http://data.tastade.org/ontology/ReligiousAffiliation"/>
        <rdfs:comment>Membership in a formal organization (partnership, firm, trading company, guild), typically involving a specific role or position (director, partner, apprentice, member).</rdfs:comment>
        <rdfs:label>Organizational Membership</rdfs:label>
        <rdfs:seeAlso></rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://data.tastade.org/ontology/Outfitting -->

    <owl:Class rdf:about="http://data.tastade.org/ontology/Outfitting">
        <rdfs:subClassOf rdf:resource="http://data.tastade.org/ontology/FinancialActivity"/>
        <rdfs:comment>The act of fitting out a ship for a crossing, typically by a partnership of merchants.</rdfs:comment>
        <rdfs:label>Outfitting</rdfs:label>
    </owl:Class>
    


    <!-- http://data.tastade.org/ontology/Ownership -->

    <owl:Class rdf:about="http://data.tastade.org/ontology/Ownership">
        <rdfs:subClassOf rdf:resource="http://data.tastade.org/ontology/BinaryRelationship"/>
        <rdfs:comment xml:lang="en">A binary relationship between the owner (actor) and the thing owned (share, ship, person, debt, property).</rdfs:comment>
        <rdfs:label xml:lang="en">Ownership</rdfs:label>
    </owl:Class>
    


    <!-- http://data.tastade.org/ontology/PersonRelationship -->

    <owl:Class rdf:about="http://data.tastade.org/ontology/PersonRelationship">
        <rdfs:subClassOf rdf:resource="http://data.tastade.org/ontology/BinaryRelationship"/>
        <rdfs:comment xml:lang="en">A binary relationship between two persons.</rdfs:comment>
        <rdfs:label xml:lang="en">Person-Relationship</rdfs:label>
    </owl:Class>
    


    <!-- http://data.tastade.org/ontology/PlaceRuling -->

    <owl:Class rdf:about="http://data.tastade.org/ontology/PlaceRuling">
        <rdfs:subClassOf rdf:resource="http://data.tastade.org/ontology/BinaryRelationship"/>
        <rdfs:comment>A time-bounded relationship expressing that a polity ruled a place during a specific period.</rdfs:comment>
        <rdfs:label>Place Ruling</rdfs:label>
    </owl:Class>
    


    <!-- http://data.tastade.org/ontology/PoliticalFunction -->

    <owl:Class rdf:about="http://data.tastade.org/ontology/PoliticalFunction">
        <rdfs:subClassOf rdf:resource="http://data.tastade.org/ontology/MembershipRelationship"/>
        <rdfs:comment>This class comprises membership relationships in which an actor holds a formal office, position, or seat within a polity&apos;s governmental or administrative body. It encompasses civic offices (such as aldermen, burgomasters, pensionaries, treasurers of a city), sovereign offices (such as councillors of state, ministers, governors, ambassadors), and other formally recognized political positions through which an actor participates in a polity&apos;s political authority, deliberation, or administration.</rdfs:comment>
        <rdfs:label>Political Function</rdfs:label>
        <skos:scopeNote>A Political Membership links an actor to a polity (via ont:belongsToGroup) and specifies the specific office or role via ont:has_relation_type (drawn from a controlled vocabulary of political roles). The membership&apos;s period captures the term of office. Use Political Membership when the group is a Polity. For formal positions in non-political organized bodies (trading companies, partnerships, firms, chambers of commerce, guilds), use OrganizationalMembership. For looser religious identity (not formal ecclesiastical office), use ReligiousAffiliation; for formal ecclesiastical offices (elder, deacon, minister), use OrganizationalMembership with the religious body as the group.</skos:scopeNote>
    </owl:Class>
    


    <!-- http://data.tastade.org/ontology/Polity -->

    <owl:Class rdf:about="http://data.tastade.org/ontology/Polity">
        <rdfs:subClassOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E74_Group"/>
        <rdfs:comment xml:lang="en">A sovereign polity with governance authority. Historical entities modeled as they existed at their time. For 16th-19th century context, includes composite monarchies, republics, empires, and chartered companies with sovereign powers.

Modeled as a subclass of E74 Group because polities are collective entities whose members are subjects/citizens. This enables uniform treatment of political membership via hasNationality (subPropertyOf P107i_is_current_or_former_member_of).</rdfs:comment>
        <rdfs:label xml:lang="en">Polity</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Polity</rdfs:seeAlso>
        <skos:altLabel xml:lang="en">Nation</skos:altLabel>
    </owl:Class>
    


    <!-- http://data.tastade.org/ontology/PolityType -->

    <owl:Class rdf:about="http://data.tastade.org/ontology/PolityType">
        <rdfs:subClassOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E55_Type"/>
        <rdfs:label>Polity Type</rdfs:label>
    </owl:Class>
    


    <!-- http://data.tastade.org/ontology/PropertyOwnership -->

    <owl:Class rdf:about="http://data.tastade.org/ontology/PropertyOwnership">
        <rdfs:subClassOf rdf:resource="http://data.tastade.org/ontology/Ownership"/>
        <rdfs:label xml:lang="en">Property Ownership</rdfs:label>
    </owl:Class>
    


    <!-- http://data.tastade.org/ontology/RelationType -->

    <owl:Class rdf:about="http://data.tastade.org/ontology/RelationType">
        <rdfs:subClassOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E55_Type"/>
        <rdfs:label xml:lang="en">Relation Type</rdfs:label>
    </owl:Class>
    


    <!-- http://data.tastade.org/ontology/ReligiousAffiliation -->

    <owl:Class rdf:about="http://data.tastade.org/ontology/ReligiousAffiliation">
        <rdfs:subClassOf rdf:resource="http://data.tastade.org/ontology/MembershipRelationship"/>
        <rdfs:comment>A person&apos;s affiliation with a religious community, denomination, or church. It is used when a person has a &apos;belief&apos; or is affiliated to a religion, and typically does not involve a specific role. If the person has an official ecclesiastical position (e.g., elder, deacon, minister), use OrganizationalMembership instead.
Examples:
&quot;Baudoin is Catholic&quot; → ReligiousMembership
&quot;Baudoin is an elder&quot; → OrganizationalMembership (role: elder)</rdfs:comment>
        <rdfs:comment>A person&apos;s membership in a religious group, denomination, or church.</rdfs:comment>
        <rdfs:label>Religious Affiliation</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://personsincontext.org/model#hasReligion</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://data.tastade.org/ontology/Residence -->

    <owl:Class rdf:about="http://data.tastade.org/ontology/Residence">
        <rdfs:subClassOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E5_Event"/>
        <rdfs:comment>A period during which a person is documented as residing in a specific place. Multiple residences over time capture geographic mobility.
Residence is a state of presence, not an intentional activity. Note the deliberate placement under E5_Event (not E7_Activity)</rdfs:comment>
        <rdfs:label>Residence</rdfs:label>
    </owl:Class>
    


    <!-- http://data.tastade.org/ontology/Share -->

    <owl:Class rdf:about="http://data.tastade.org/ontology/Share">
        <rdfs:subClassOf rdf:resource="http://data.tastade.org/ontology/FinancialInstrument"/>
        <rdfs:comment xml:lang="en">A share represents an ownership stake in a partnership or organization. The share is connected to its issuer via ont:hasIssuer (the organization that issued the share and is obligated by its terms). Ownership of the share by actors over time is captured via Share_Ownership relationships (with ont:hasOwner and ont:ownsShare).</rdfs:comment>
        <rdfs:label xml:lang="en">Share</rdfs:label>
    </owl:Class>
    


    <!-- http://data.tastade.org/ontology/ShareOwnership -->

    <owl:Class rdf:about="http://data.tastade.org/ontology/ShareOwnership">
        <rdfs:subClassOf rdf:resource="http://data.tastade.org/ontology/FinancialInstrumentOwnership"/>
        <rdfs:label xml:lang="en">Share Ownership</rdfs:label>
    </owl:Class>
    


    <!-- http://data.tastade.org/ontology/ShareTransfer -->

    <owl:Class rdf:about="http://data.tastade.org/ontology/ShareTransfer">
        <rdfs:subClassOf rdf:resource="http://data.tastade.org/ontology/FinancialActivity"/>
        <rdfs:comment>Sale/purchase/gift of partnership shares</rdfs:comment>
        <rdfs:label xml:lang="en">Share Transfer</rdfs:label>
    </owl:Class>
    


    <!-- http://data.tastade.org/ontology/Ship -->

    <owl:Class rdf:about="http://data.tastade.org/ontology/Ship">
        <rdfs:subClassOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E22_Human-Made_Object"/>
        <rdfs:comment xml:lang="en">This class comprises vessels, ships of different kinds, which can cross large open waters. Ships have been important contributors to human migration and commerce.</rdfs:comment>
        <rdfs:label>Ship</rdfs:label>
        <schema:sameAs>http://www.sealitproject.eu/ontology/Ship/</schema:sameAs>
    </owl:Class>
    


    <!-- http://data.tastade.org/ontology/ShipOwnership -->

    <owl:Class rdf:about="http://data.tastade.org/ontology/ShipOwnership">
        <rdfs:subClassOf rdf:resource="http://data.tastade.org/ontology/PropertyOwnership"/>
        <rdfs:label xml:lang="en">Ship Ownership</rdfs:label>
    </owl:Class>
    


    <!-- http://data.tastade.org/ontology/SocialRelationship -->

    <owl:Class rdf:about="http://data.tastade.org/ontology/SocialRelationship">
        <rdfs:subClassOf rdf:resource="http://data.tastade.org/ontology/PersonRelationship"/>
        <rdfs:comment xml:lang="en">A non-kinship social relationship between two persons, including master-apprentice, patron-client, godparent-godchild, witness, and similar. It also includes friends, associates, patrons, godparents, etc.). The specific nature is captured via has_relation_type.</rdfs:comment>
        <rdfs:label xml:lang="en">Social-Relationship</rdfs:label>
    </owl:Class>
    


