    <!-- http://data.tastade.org/ontology/actor_0010 -->

    <owl:NamedIndividual rdf:about="http://data.tastade.org/ontology/actor_0010">
        <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E74_Group"/>
        <hasMember rdf:resource="http://data.tastade.org/ontology/actor_0016"/>
        <outfittedForCrossing rdf:resource="http://data.tastade.org/ontology/event_0010"/>
