<?xml version="1.0"?>
<rdf:RDF xmlns="http://data.tastade.org/ontology/"
     xml:base="http://data.tastade.org/ontology/"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:tsd="http://data.tastade.org/ontology/"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:bibo="http://purl.org/ontology/bibo/"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:picom="https://personsincontext.org/model#ontology"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:schema="https://schema.org/"
     xmlns:cidoc-crm="http://www.cidoc-crm.org/cidoc-crm/">
    <owl:Ontology rdf:about="http://data.tastade.org/ontology/">
        <owl:versionIRI rdf:resource="http://data.tastade.org/ontology/4.0.0"/>
        <owl:imports rdf:resource="http://www.cidoc-crm.org/cidoc-crm/7.1.3/"/>
        <owl:imports rdf:resource="http://www.w3.org/2004/02/skos/core"/>
        <rdfs:comment xml:lang="en">TASTADE project ontology built on the basis of CIDOC CRM v7.1.3 implemented in RDFS.

Created by Liliana Melgar together with the TASTADE project members, from March 2026.
CC BY 4.0 https://creativecommons.org/licenses/by/4.0/legalcode</rdfs:comment>
        <rdfs:label>TASTADE project ontology</rdfs:label>
        <owl:versionInfo xml:lang="en">RDFs Implementation (February 2024) of CIDOC-CRM 7.1.3</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/elements/1.1/creator -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/creator"/>
    


    <!-- http://purl.org/dc/elements/1.1/date -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/date"/>
    


    <!-- https://schema.org/sameAs -->

    <owl:AnnotationProperty rdf:about="https://schema.org/sameAs">
        <rdfs:comment xml:lang="en">URL of a reference web page that unambiguously indicates the item&apos;s identity.</rdfs:comment>
        <rdfs:label xml:lang="en">sameAs</rdfs:label>
        <skos:scopeNote xml:lang="en">Links this entity to an equivalent entity at an external URL (e.g., authority records like VIAF or Wikidata, or entries in external databases). Expected domain: any entity. Expected range: a URL/IRI.</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/2001/XMLSchema#date -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://data.tastade.org/ontology/activePeriod -->

    <owl:ObjectProperty rdf:about="http://data.tastade.org/ontology/activePeriod">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P4_has_time-span"/>
        <rdfs:domain rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E77_Persistent_Item"/>
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E52_Time-Span"/>
        <rdfs:comment xml:lang="en">The time-span during which this entity was active, in existence, or in use. For persons, corresponds to Wikidata&apos;s floruit concept when birth/death are unknown. For nations, when they existed as political entities. For currencies, when they were in circulation.</rdfs:comment>
        <rdfs:label xml:lang="en">active period</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.wikidata.org/entity/P1317</rdfs:seeAlso>
        <skos:scopeNote xml:lang="en">Use for entity existence periods. Distinct from birth/death dates on persons (use ont:birthDate, ont:deathDate for those specifically). For organizations, distinct from foundation/dissolution events (use those when the events themselves matter).</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://data.tastade.org/ontology/actualUsePeriod -->

    <owl:ObjectProperty rdf:about="http://data.tastade.org/ontology/actualUsePeriod">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P4_has_time-span"/>
        <rdfs:domain rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E98_Currency"/>
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E52_Time-Span"/>
        <rdfs:comment xml:lang="en">The period during which the currency was actually used in documents/transactions, including any period of persistence beyond official status.</rdfs:comment>
        <rdfs:label xml:lang="en">actual use period</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://data.tastade.org/ontology/belongsToGroup -->

    <owl:ObjectProperty rdf:about="http://data.tastade.org/ontology/belongsToGroup">
        <rdfs:subPropertyOf rdf:resource="http://data.tastade.org/ontology/isAssociatedWithGroup"/>
        <owl:inverseOf rdf:resource="http://data.tastade.org/ontology/hasMember"/>
        <rdfs:domain rdf:resource="http://data.tastade.org/ontology/MembershipRelationship"/>
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E74_Group"/>
        <rdfs:comment xml:lang="en">Links a Membership relationship to the organization or group in which the actor holds membership.</rdfs:comment>
        <rdfs:label xml:lang="en">belongs to group</rdfs:label>
        <rdfs:seeAlso xml:lang="en">crm:P107i_is_current_or_former_member_of</rdfs:seeAlso>
    </owl:ObjectProperty>
    


    <!-- http://data.tastade.org/ontology/belongsToOrganization -->

    <owl:ObjectProperty rdf:about="http://data.tastade.org/ontology/belongsToOrganization">
        <rdfs:subPropertyOf rdf:resource="http://data.tastade.org/ontology/belongsToGroup"/>
        <rdfs:domain rdf:resource="http://data.tastade.org/ontology/OrganizationalMembership"/>
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E74_Group"/>
        <rdfs:label>belongs to organization</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://data.tastade.org/ontology/birthDate -->

    <owl:ObjectProperty rdf:about="http://data.tastade.org/ontology/birthDate">
        <rdfs:domain rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E21_Person"/>
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E52_Time-Span"/>
        <rdfs:comment xml:lang="en">(not for data entry, only kept to see if useful for SPARQL constructs). This is a Tastade-defined property to register dates of birth when they are uncertain, benefitting from CIDOC&apos;s TimeSpan class.</rdfs:comment>
        <rdfs:label xml:lang="en">birth date</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://schema.org/birthDate</rdfs:seeAlso>
    </owl:ObjectProperty>
    


    <!-- http://data.tastade.org/ontology/birthPlace -->

    <owl:ObjectProperty rdf:about="http://data.tastade.org/ontology/birthPlace">
        <rdfs:domain rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E21_Person"/>
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E53_Place"/>
        <rdfs:comment>(not for data entry, only kept to see if useful for SPARQL constructs)</rdfs:comment>
        <rdfs:label xml:lang="en">birth place</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://schema.org/birthPlace</rdfs:seeAlso>
    </owl:ObjectProperty>
    


    <!-- http://data.tastade.org/ontology/connectedToPolity -->

    <owl:ObjectProperty rdf:about="http://data.tastade.org/ontology/connectedToPolity">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E1_CRM_Entity"/>
        <rdfs:range rdf:resource="http://data.tastade.org/ontology/Polity"/>
        <rdfs:label xml:lang="en">connected to polity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://data.tastade.org/ontology/deathDate -->

    <owl:ObjectProperty rdf:about="http://data.tastade.org/ontology/deathDate">
        <rdfs:domain rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E21_Person"/>
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E52_Time-Span"/>
        <rdfs:comment>(not for data entry, only kept to see if useful for SPARQL constructs)</rdfs:comment>
        <rdfs:label xml:lang="en">death date</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://schema.org/deathDate</rdfs:seeAlso>
    </owl:ObjectProperty>
    


    <!-- http://data.tastade.org/ontology/deathPlace -->

    <owl:ObjectProperty rdf:about="http://data.tastade.org/ontology/deathPlace">
        <rdfs:domain rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E21_Person"/>
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E53_Place"/>
        <rdfs:comment>(not for data entry, only kept to see if useful for SPARQL constructs)</rdfs:comment>
        <rdfs:label xml:lang="en">death place</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://schema.org/deathPlace</rdfs:seeAlso>
    </owl:ObjectProperty>
    


    <!-- http://data.tastade.org/ontology/employedBy -->

    <owl:ObjectProperty rdf:about="http://data.tastade.org/ontology/employedBy">
        <rdfs:subPropertyOf rdf:resource="http://data.tastade.org/ontology/belongsToGroup"/>
        <rdfs:domain rdf:resource="http://data.tastade.org/ontology/EmploymentRelationship"/>
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E74_Group"/>
        <rdfs:label>employed by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://data.tastade.org/ontology/hasAssociatedActor -->

    <owl:ObjectProperty rdf:about="http://data.tastade.org/ontology/hasAssociatedActor">
        <rdfs:subPropertyOf rdf:resource="http://data.tastade.org/ontology/relationFrom"/>
        <rdfs:domain rdf:resource="http://data.tastade.org/ontology/GroupRelationship"/>
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E39_Actor"/>
        <rdfs:comment>Generic property linking a group relationship to the actor involved. Use subproperties for specific roles (hasMember, hasEmployee).</rdfs:comment>
        <rdfs:label>has associated actor</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://data.tastade.org/ontology/hasDebtor -->

    <owl:ObjectProperty rdf:about="http://data.tastade.org/ontology/hasDebtor">
        <rdfs:subPropertyOf rdf:resource="http://data.tastade.org/ontology/relationFrom"/>
        <rdfs:domain rdf:resource="http://data.tastade.org/ontology/Loan"/>
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E39_Actor"/>
        <rdfs:comment xml:lang="en">The actor obligated to repay the loan (borrower). Aligned with CIDOC&apos;s P105_right_held_by (loan → actor with obligation).</rdfs:comment>
        <rdfs:label>has debtor</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://data.tastade.org/ontology/hasEmployee -->

    <owl:ObjectProperty rdf:about="http://data.tastade.org/ontology/hasEmployee">
        <rdfs:subPropertyOf rdf:resource="http://data.tastade.org/ontology/hasAssociatedActor"/>
        <rdfs:domain rdf:resource="http://data.tastade.org/ontology/EmploymentRelationship"/>
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E39_Actor"/>
        <rdfs:label>has employee</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://data.tastade.org/ontology/hasFlag -->

    <owl:ObjectProperty rdf:about="http://data.tastade.org/ontology/hasFlag">
        <rdfs:subPropertyOf rdf:resource="http://data.tastade.org/ontology/connectedToPolity"/>
        <rdfs:domain rdf:resource="http://data.tastade.org/ontology/Ship"/>
        <rdfs:range rdf:resource="http://data.tastade.org/ontology/Polity"/>
        <rdfs:comment xml:lang="en">The flag is a property of the ship (its &apos;national&apos; flag/registration), not a property of the ownership relationship.</rdfs:comment>
        <rdfs:label xml:lang="en">has flag</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://data.tastade.org/ontology/hasGender -->

    <owl:ObjectProperty rdf:about="http://data.tastade.org/ontology/hasGender">
        <rdfs:domain rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E21_Person"/>
        <rdfs:range rdf:resource="http://data.tastade.org/ontology/GenderType"/>
        <rdfs:label xml:lang="en">has gender</rdfs:label>
        <rdfs:seeAlso>schema.org/gender</rdfs:seeAlso>
    </owl:ObjectProperty>
    


    <!-- http://data.tastade.org/ontology/hasIssuer -->

    <owl:ObjectProperty rdf:about="http://data.tastade.org/ontology/hasIssuer">
        <rdfs:subPropertyOf rdf:resource="http://data.tastade.org/ontology/relationFrom"/>
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P105_right_held_by"/>
        <rdfs:domain rdf:resource="http://data.tastade.org/ontology/Share"/>
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E74_Group"/>
        <rdfs:comment xml:lang="en">The actor (typically a group, partnership, or company) that issued the share and is obligated by its terms. This is a direct property from the share to the issuer, simplifying CIDOC&apos;s fuller pattern that would use a separate Creation event (E65) with P14_carried_out_by (issuer) and P94_has_created (share).
Semantically similar to CIDOC&apos;s P105 right_held_by (Legal Object → Actor holding a right on it), but specifically restricted to the issuing role. Parallel to ont:hasDebtor on Loans.</rdfs:comment>
        <rdfs:label xml:lang="en">has issuer</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://data.tastade.org/ontology/hasMember -->

    <owl:ObjectProperty rdf:about="http://data.tastade.org/ontology/hasMember">
        <rdfs:subPropertyOf rdf:resource="http://data.tastade.org/ontology/hasAssociatedActor"/>
        <rdfs:domain rdf:resource="http://data.tastade.org/ontology/MembershipRelationship"/>
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E39_Actor"/>
        <rdfs:comment xml:lang="en">Links a Membership relationship to the person or actor who holds membership in the group.</rdfs:comment>
        <rdfs:label xml:lang="en">has member</rdfs:label>
        <rdfs:seeAlso>crm:P107_has_current_or_former_member</rdfs:seeAlso>
        <skos:scopeNote>Use for the actor who has an active participation in organizing and fitting out the crossing. If an actor sells a part (interest) to another actor, only register the first one (the one who sold). The transfer is registered as a financial event.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://data.tastade.org/ontology/hasMonetaryValue -->

    <owl:ObjectProperty rdf:about="http://data.tastade.org/ontology/hasMonetaryValue">
        <rdfs:domain rdf:resource="http://data.tastade.org/ontology/FinancialInstrument"/>
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E97_Monetary_Amount"/>
        <rdfs:label>has monetary value</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://data.tastade.org/ontology/hasNationality -->

    <owl:ObjectProperty rdf:about="http://data.tastade.org/ontology/hasNationality">
        <rdfs:subPropertyOf rdf:resource="http://data.tastade.org/ontology/connectedToPolity"/>
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P107i_is_current_or_former_member_of"/>
        <rdfs:domain rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E21_Person"/>
        <rdfs:range rdf:resource="http://data.tastade.org/ontology/Polity"/>
        <rdfs:label xml:lang="en">has nationality</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://data.tastade.org/ontology/hasOutfitter -->

    <owl:ObjectProperty rdf:about="http://data.tastade.org/ontology/hasOutfitter">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P14_carried_out_by"/>
        <rdfs:domain rdf:resource="http://data.tastade.org/ontology/Outfitting"/>
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E39_Actor"/>
        <rdfs:comment>The person or group who carried out the outfitting of a ship for a specific crossing.</rdfs:comment>
        <rdfs:label>has outfitter</rdfs:label>
        <skos:altLabel xml:lang="fr">a pour armateur</skos:altLabel>
        <skos:scopeNote>The outfitter was responsible for preparing the ship: securing capital, hiring crew, loading provisions, and arranging the crossing. Can be an individual merchant, an outfitting partnership, or a trading company.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://data.tastade.org/ontology/hasOwner -->

    <owl:ObjectProperty rdf:about="http://data.tastade.org/ontology/hasOwner">
        <rdfs:subPropertyOf rdf:resource="http://data.tastade.org/ontology/relationFrom"/>
        <rdfs:domain rdf:resource="http://data.tastade.org/ontology/Ownership"/>
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E39_Actor"/>
        <rdfs:comment xml:lang="en">The actor who holds ownership in this reified ownership relationship. Distinct from CIDOC&apos;s P51/P52 which connect directly from owned entity to actor; this project uses reified ownership to capture time-spans and source attribution.</rdfs:comment>
        <rdfs:label xml:lang="en">has owner</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://data.tastade.org/ontology/hasPrincipalAmount -->

    <owl:ObjectProperty rdf:about="http://data.tastade.org/ontology/hasPrincipalAmount">
        <rdfs:subPropertyOf rdf:resource="http://data.tastade.org/ontology/hasMonetaryValue"/>
        <rdfs:domain rdf:resource="http://data.tastade.org/ontology/Loan"/>
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E97_Monetary_Amount"/>
        <rdfs:comment>The original amount of money lent, including value and currency.</rdfs:comment>
        <rdfs:label xml:lang="en">has principal amount</rdfs:label>
        <skos:scopeNote xml:lang="en">E97_Monetary_Amount carries both amount (crm:P181) and currency (crm:P180).</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://data.tastade.org/ontology/hasRelatedIndividual -->

    <owl:ObjectProperty rdf:about="http://data.tastade.org/ontology/hasRelatedIndividual">
        <rdfs:subPropertyOf rdf:resource="http://data.tastade.org/ontology/relationTo"/>
        <rdfs:domain rdf:resource="http://data.tastade.org/ontology/PersonRelationship"/>
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E21_Person"/>
        <rdfs:comment>The person on the &apos;to&apos; side of a person-to-person relationship (family or social). Use specific subproperties (relatedFamilyMember, relatedPerson) for typed relationships.</rdfs:comment>
        <rdfs:label>has related individual</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://data.tastade.org/ontology/hasRelationType -->

    <owl:ObjectProperty rdf:about="http://data.tastade.org/ontology/hasRelationType">
        <rdfs:domain rdf:resource="http://data.tastade.org/ontology/BinaryRelationship"/>
        <rdfs:range rdf:resource="http://data.tastade.org/ontology/RelationType"/>
        <rdfs:comment xml:lang="en">Links a binary relationship to a controlled vocabulary term that specifies its type.</rdfs:comment>
        <rdfs:label xml:lang="en">has relation type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://data.tastade.org/ontology/hasRuledPlace -->

    <owl:ObjectProperty rdf:about="http://data.tastade.org/ontology/hasRuledPlace">
        <rdfs:subPropertyOf rdf:resource="http://data.tastade.org/ontology/relationFrom"/>
        <rdfs:domain rdf:resource="http://data.tastade.org/ontology/PlaceRuling"/>
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E53_Place"/>
        <rdfs:comment>The place ruled in this Place Ruling relationship.</rdfs:comment>
        <rdfs:label>has ruled place</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://data.tastade.org/ontology/hasRulingPolity -->

    <owl:ObjectProperty rdf:about="http://data.tastade.org/ontology/hasRulingPolity">
        <rdfs:subPropertyOf rdf:resource="http://data.tastade.org/ontology/isAssociatedWithGroup"/>
        <rdfs:domain rdf:resource="http://data.tastade.org/ontology/PlaceRuling"/>
        <rdfs:range rdf:resource="http://data.tastade.org/ontology/Polity"/>
        <rdfs:label>has ruling polity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://data.tastade.org/ontology/hasTransferAmount -->

    <owl:ObjectProperty rdf:about="http://data.tastade.org/ontology/hasTransferAmount">
        <rdfs:subPropertyOf rdf:resource="http://data.tastade.org/ontology/hasMonetaryValue"/>
        <rdfs:domain rdf:resource="http://data.tastade.org/ontology/ShareTransfer"/>
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E97_Monetary_Amount"/>
        <rdfs:comment>The monetary amount involved in the transfer (may be the share&apos;s face value or a negotiated price).</rdfs:comment>
        <rdfs:label>has transfer amount</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://data.tastade.org/ontology/hasTransferee -->

    <owl:ObjectProperty rdf:about="http://data.tastade.org/ontology/hasTransferee">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P22_transferred_title_to"/>
        <rdfs:domain rdf:resource="http://data.tastade.org/ontology/ShareTransfer"/>
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E39_Actor"/>
        <rdfs:comment>The actor buying/receiving the share.</rdfs:comment>
        <rdfs:label>has transferee</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://data.tastade.org/ontology/hasTransferredShare -->

    <owl:ObjectProperty rdf:about="http://data.tastade.org/ontology/hasTransferredShare">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P24_transferred_title_of"/>
        <rdfs:domain rdf:resource="http://data.tastade.org/ontology/ShareTransfer"/>
        <rdfs:range rdf:resource="http://data.tastade.org/ontology/Share"/>
        <rdfs:comment>The share whose ownership changes in this transfer.</rdfs:comment>
        <rdfs:label>has transferred share</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://data.tastade.org/ontology/hasTransferrer -->

    <owl:ObjectProperty rdf:about="http://data.tastade.org/ontology/hasTransferrer">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P23_transferred_title_from"/>
        <rdfs:domain rdf:resource="http://data.tastade.org/ontology/ShareTransfer"/>
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E39_Actor"/>
        <rdfs:comment>The actor selling/transferring the share.</rdfs:comment>
        <rdfs:label xml:lang="en">has transferrer</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://data.tastade.org/ontology/hasUnderlying -->

    <owl:ObjectProperty rdf:about="http://data.tastade.org/ontology/hasUnderlying">
        <rdfs:domain rdf:resource="http://data.tastade.org/ontology/FinancialInstrument"/>
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E1_CRM_Entity"/>
        <rdfs:comment>The entity or venture that this financial instrument represents a stake in, claim against, or interest in. &apos;Underlying&apos; is standard financial terminology for what gives an instrument its value or purpose.</rdfs:comment>
        <rdfs:label>has underlying</rdfs:label>
        <skos:scopeNote>For equity shares in a company, the underlying is the company itself 
(an ongoing legal entity), thus, the property &quot;has issuer&quot; is enough. 
But, for shares in a venture (synonymous with 
&quot;crossing&quot; in this project — a specific maritime voyage), the 
underlying is the crossing, which has a defined start and end tied 
to the crossing. The issuer of the share is the outfitting partnership, and it also requires the &quot;shareInCrossing&quot; property.
For loans, the underlying is typically the borrower, 
sometimes with specific collateral (such as a ship in bottomry loans). 
For derivatives, the underlying is the referenced asset. Use &quot;loanTo&quot; (the loan recipients).</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://data.tastade.org/ontology/holdsPoliticalOfficeIn -->

    <owl:ObjectProperty rdf:about="http://data.tastade.org/ontology/holdsPoliticalOfficeIn">
        <rdfs:subPropertyOf rdf:resource="http://data.tastade.org/ontology/belongsToGroup"/>
        <rdfs:domain rdf:resource="http://data.tastade.org/ontology/PoliticalFunction"/>
        <rdfs:range rdf:resource="http://data.tastade.org/ontology/Polity"/>
        <rdfs:comment>The polity in whose governmental or administrative body the actor holds a formal office.</rdfs:comment>
        <rdfs:label>holds political office in</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://data.tastade.org/ontology/isAffiliatedWithReligiousGroup -->

    <owl:ObjectProperty rdf:about="http://data.tastade.org/ontology/isAffiliatedWithReligiousGroup">
        <rdfs:subPropertyOf rdf:resource="http://data.tastade.org/ontology/isAssociatedWithGroup"/>
        <rdfs:domain rdf:resource="http://data.tastade.org/ontology/ReligiousAffiliation"/>
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E74_Group"/>
        <rdfs:comment>Links a reified ReligiousAffiliation to the religious group (denomination, church, congregation) the person is affiliated with.</rdfs:comment>
        <rdfs:label>is affiliated with religious group</rdfs:label>
        <rdfs:seeAlso>pico:hasReligion</rdfs:seeAlso>
    </owl:ObjectProperty>
    


    <!-- http://data.tastade.org/ontology/isAssociatedWithGroup -->

    <owl:ObjectProperty rdf:about="http://data.tastade.org/ontology/isAssociatedWithGroup">
        <rdfs:subPropertyOf rdf:resource="http://data.tastade.org/ontology/relationTo"/>
        <rdfs:domain rdf:resource="http://data.tastade.org/ontology/BinaryRelationship"/>
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E74_Group"/>
        <rdfs:comment>Generic property linking a binary relationship to the associated group (a group in the sense of E74, which includes polities). Use subproperties for specific relationship types (belongsToGroup for membership, employedBy for employment, hasRulingPolity for place ruling).

&quot;When entering a membership, you&apos;re creating three connections:
→ hasMember → Baudoin
→ isAssociatedWithGroup → the Négresse partnership
→ time-span, source, type, etc.
The isAssociatedWithGroup property connects the MEMBERSHIP RECORD to the group — not Baudoin to the group directly.&quot;</rdfs:comment>
        <rdfs:label>is associated with group</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://data.tastade.org/ontology/issuedByPolity -->

    <owl:ObjectProperty rdf:about="http://data.tastade.org/ontology/issuedByPolity">
        <rdfs:subPropertyOf rdf:resource="http://data.tastade.org/ontology/connectedToPolity"/>
        <rdfs:domain rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E98_Currency"/>
        <rdfs:range rdf:resource="http://data.tastade.org/ontology/Polity"/>
        <rdfs:comment>Currency issuer.</rdfs:comment>
        <rdfs:label xml:lang="en">issued by polity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://data.tastade.org/ontology/loanDueDate -->

    <owl:ObjectProperty rdf:about="http://data.tastade.org/ontology/loanDueDate">
        <rdfs:domain rdf:resource="http://data.tastade.org/ontology/Loan"/>
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E52_Time-Span"/>
        <rdfs:label xml:lang="en">loan due date</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://data.tastade.org/ontology/loanOriginationDate -->

    <owl:ObjectProperty rdf:about="http://data.tastade.org/ontology/loanOriginationDate">
        <rdfs:domain rdf:resource="http://data.tastade.org/ontology/Loan"/>
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E52_Time-Span"/>
        <rdfs:comment xml:lang="en">When the loan was subcribed.</rdfs:comment>
        <rdfs:label xml:lang="en">loan origination date</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://data.tastade.org/ontology/membershipPeriod -->

    <owl:ObjectProperty rdf:about="http://data.tastade.org/ontology/membershipPeriod">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P4_has_time-span"/>
        <rdfs:domain rdf:resource="http://data.tastade.org/ontology/MembershipRelationship"/>
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E52_Time-Span"/>
        <rdfs:label xml:lang="en">membership period</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://data.tastade.org/ontology/officialPeriod -->

    <owl:ObjectProperty rdf:about="http://data.tastade.org/ontology/officialPeriod">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P4_has_time-span"/>
        <rdfs:domain rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E98_Currency"/>
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E52_Time-Span"/>
        <rdfs:comment>The period during which the currency was legally recognized as official tender.</rdfs:comment>
        <rdfs:label xml:lang="en">official period</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://data.tastade.org/ontology/outfittedForCrossing -->

    <owl:ObjectProperty rdf:about="http://data.tastade.org/ontology/outfittedForCrossing">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P20_had_specific_purpose"/>
        <rdfs:domain rdf:resource="http://data.tastade.org/ontology/Outfitting"/>
        <rdfs:range rdf:resource="http://data.tastade.org/ontology/Crossing"/>
        <rdfs:comment>The crossing for which the ship was physically fitted out during this outfitting event.
&apos;Fitting out&apos; or &apos;outfitting&apos; refers to the process of preparing a vessel for a specific crossing: securing capital, hiring crew, loading provisions, acquiring trade goods, and arranging insurance.</rdfs:comment>
        <rdfs:label xml:lang="en">outfitted for crossing</rdfs:label>
        <rdfs:seeAlso>P16_used_specific_object</rdfs:seeAlso>
        <skos:altLabel xml:lang="fr">armé pour la traversée</skos:altLabel>
        <skos:scopeNote>Links an OutfittingEvent to its intended Crossing. 

The outfitting was carried out in order to prepare for this specific crossing. Links the preparatory event (outfitting) to its intended purpose (crossing).

The outfitting typically precedes the actual departure by weeks or months. If the ship was outfitted but did not complete the voyage (shipwreck, cancellation), this property still links to the intended Crossing. For multi-leg voyages (triangular trade), the outfitting event may be linked to the primary departure crossing of the venture, with additional ActorEvents or FinancialEvents capturing subsequent legs.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://data.tastade.org/ontology/outfittedShip -->

    <owl:ObjectProperty rdf:about="http://data.tastade.org/ontology/outfittedShip">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P16_used_specific_object"/>
        <rdfs:domain rdf:resource="http://data.tastade.org/ontology/Outfitting"/>
        <rdfs:range rdf:resource="http://data.tastade.org/ontology/Ship"/>
        <rdfs:label xml:lang="en">outfitted ship</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://data.tastade.org/ontology/ownershipPeriod -->

    <owl:ObjectProperty rdf:about="http://data.tastade.org/ontology/ownershipPeriod">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P4_has_time-span"/>
        <rdfs:domain rdf:resource="http://data.tastade.org/ontology/Ownership"/>
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E52_Time-Span"/>
        <rdfs:comment xml:lang="en">The period during which the owner held the entity in this reified ownership relationship.</rdfs:comment>
        <rdfs:label xml:lang="en">ownership period</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://data.tastade.org/ontology/ownsEnslavedPerson -->

    <owl:ObjectProperty rdf:about="http://data.tastade.org/ontology/ownsEnslavedPerson">
        <rdfs:subPropertyOf rdf:resource="http://data.tastade.org/ontology/ownsEntity"/>
        <rdfs:domain rdf:resource="http://data.tastade.org/ontology/EnslavedPersonOwnership"/>
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E21_Person"/>
        <rdfs:label xml:lang="en">owns enslaved person</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://data.tastade.org/ontology/ownsEntity -->

    <owl:ObjectProperty rdf:about="http://data.tastade.org/ontology/ownsEntity">
        <rdfs:subPropertyOf rdf:resource="http://data.tastade.org/ontology/relationTo"/>
        <rdfs:domain rdf:resource="http://data.tastade.org/ontology/Ownership"/>
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E1_CRM_Entity"/>
        <rdfs:label xml:lang="en">owns entity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://data.tastade.org/ontology/ownsFinancialInstrument -->

    <owl:ObjectProperty rdf:about="http://data.tastade.org/ontology/ownsFinancialInstrument">
        <rdfs:subPropertyOf rdf:resource="http://data.tastade.org/ontology/ownsEntity"/>
        <rdfs:domain rdf:resource="http://data.tastade.org/ontology/FinancialInstrumentOwnership"/>
        <rdfs:range rdf:resource="http://data.tastade.org/ontology/FinancialInstrument"/>
        <rdfs:comment>Links an Ownership relationship to the financial instrument being owned. Generic property for financial instrument ownership; use specific subproperties (ownsLoan, ownsShare) for typed ownership.</rdfs:comment>
        <rdfs:label>owns financial instrument</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://data.tastade.org/ontology/ownsLoan -->

    <owl:ObjectProperty rdf:about="http://data.tastade.org/ontology/ownsLoan">
        <rdfs:subPropertyOf rdf:resource="http://data.tastade.org/ontology/ownsFinancialInstrument"/>
        <rdfs:domain rdf:resource="http://data.tastade.org/ontology/LoanOwnership"/>
        <rdfs:range rdf:resource="http://data.tastade.org/ontology/Loan"/>
        <rdfs:comment>The loan owned by the creditor.</rdfs:comment>
        <rdfs:label>owns loan</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://data.tastade.org/ontology/ownsProperty -->

    <owl:ObjectProperty rdf:about="http://data.tastade.org/ontology/ownsProperty">
        <rdfs:subPropertyOf rdf:resource="http://data.tastade.org/ontology/ownsEntity"/>
        <rdfs:domain rdf:resource="http://data.tastade.org/ontology/PropertyOwnership"/>
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E18_Physical_Thing"/>
        <rdfs:label xml:lang="en">owns property</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://data.tastade.org/ontology/ownsShare -->

    <owl:ObjectProperty rdf:about="http://data.tastade.org/ontology/ownsShare">
        <rdfs:subPropertyOf rdf:resource="http://data.tastade.org/ontology/ownsFinancialInstrument"/>
        <rdfs:domain rdf:resource="http://data.tastade.org/ontology/ShareOwnership"/>
        <rdfs:range rdf:resource="http://data.tastade.org/ontology/Share"/>
        <rdfs:comment xml:lang="en">Links a ShareOwnership to the share being owned.</rdfs:comment>
        <rdfs:label xml:lang="en">owns share</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://data.tastade.org/ontology/relatedFamilyMember -->

    <owl:ObjectProperty rdf:about="http://data.tastade.org/ontology/relatedFamilyMember">
        <rdfs:subPropertyOf rdf:resource="http://data.tastade.org/ontology/hasRelatedIndividual"/>
        <rdfs:domain rdf:resource="http://data.tastade.org/ontology/FamilyRelationship"/>
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E21_Person"/>
        <rdfs:label>related family member</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://data.tastade.org/ontology/relatedPerson -->

    <owl:ObjectProperty rdf:about="http://data.tastade.org/ontology/relatedPerson">
        <rdfs:subPropertyOf rdf:resource="http://data.tastade.org/ontology/hasRelatedIndividual"/>
        <rdfs:domain rdf:resource="http://data.tastade.org/ontology/SocialRelationship"/>
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E21_Person"/>
        <rdfs:comment>The person on the &apos;to&apos; side of a social relationship.</rdfs:comment>
        <rdfs:label>related person</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://data.tastade.org/ontology/relationFrom -->

    <owl:ObjectProperty rdf:about="http://data.tastade.org/ontology/relationFrom">
        <rdfs:domain rdf:resource="http://data.tastade.org/ontology/BinaryRelationship"/>
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E39_Actor"/>
        <rdfs:comment xml:lang="en">The entity (actor, group) that is the subject of this relation. Links a binary relationship to one of the two participants. Convention: this is the entity from whose perspective the relation type is described.</rdfs:comment>
        <rdfs:label xml:lang="en">relation from</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://data.tastade.org/ontology/relationTo -->

    <owl:ObjectProperty rdf:about="http://data.tastade.org/ontology/relationTo">
        <rdfs:domain rdf:resource="http://data.tastade.org/ontology/BinaryRelationship"/>
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E1_CRM_Entity"/>
        <rdfs:comment xml:lang="en">Links a binary relationship to the other entity participant.</rdfs:comment>
        <rdfs:label xml:lang="en">relation to</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://data.tastade.org/ontology/rulingPeriod -->

    <owl:ObjectProperty rdf:about="http://data.tastade.org/ontology/rulingPeriod">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P4_has_time-span"/>
        <rdfs:domain rdf:resource="http://data.tastade.org/ontology/PlaceRuling"/>
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E52_Time-Span"/>
        <rdfs:label xml:lang="en">ruling period</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://data.tastade.org/ontology/securingCrossing -->

    <owl:ObjectProperty rdf:about="http://data.tastade.org/ontology/securingCrossing">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P20_had_specific_purpose"/>
        <rdfs:domain rdf:resource="http://data.tastade.org/ontology/BottomryLoan"/>
        <rdfs:range rdf:resource="http://data.tastade.org/ontology/Crossing"/>
        <rdfs:comment>The voyage whose success triggers repayment.</rdfs:comment>
        <rdfs:label>securing crossing</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://data.tastade.org/ontology/shareInCrossing -->

    <owl:ObjectProperty rdf:about="http://data.tastade.org/ontology/shareInCrossing">
        <rdfs:subPropertyOf rdf:resource="http://data.tastade.org/ontology/hasUnderlying"/>
        <rdfs:domain rdf:resource="http://data.tastade.org/ontology/Share"/>
        <rdfs:range rdf:resource="http://data.tastade.org/ontology/Crossing"/>
        <rdfs:comment>Links a share to the specific crossing it represents a stake in.</rdfs:comment>
        <rdfs:label>share in crossing</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://data.tastade.org/ontology/shareIssuanceDate -->

    <owl:ObjectProperty rdf:about="http://data.tastade.org/ontology/shareIssuanceDate">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P4_has_time-span"/>
        <rdfs:domain rdf:resource="http://data.tastade.org/ontology/Share"/>
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E52_Time-Span"/>
        <rdfs:comment xml:lang="en">The date when the share was issued/created by the issuing organization.</rdfs:comment>
        <rdfs:label xml:lang="en">share issuance date</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://data.tastade.org/ontology/shareValue -->

    <owl:ObjectProperty rdf:about="http://data.tastade.org/ontology/shareValue">
        <rdfs:subPropertyOf rdf:resource="http://data.tastade.org/ontology/hasMonetaryValue"/>
        <rdfs:domain rdf:resource="http://data.tastade.org/ontology/Share"/>
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E97_Monetary_Amount"/>
        <rdfs:label xml:lang="en">share value</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://personsincontext.org/model#hasAncestor -->

    <owl:ObjectProperty rdf:about="https://personsincontext.org/model#hasAncestor">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:comment xml:lang="en">&quot;hasAncestor is not meant to be used as a property for PersonObservations or PersonReconstructions. It is a superclass of sdo:Parent. Since hasAncestor is a owl:TransitiveProperty, this will make the parent of your parent into your ancestor.&quot; (https://www.personsincontext.org/model/#hasAncestor)</rdfs:comment>
        <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://personsincontext.org/model#hasAncestor</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">hasAncestor</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://personsincontext.org/model#hasChild-in-law -->

    <owl:ObjectProperty rdf:about="https://personsincontext.org/model#hasChild-in-law">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:label xml:lang="en">hasChild-in-law</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://personsincontext.org/model#hasCousin -->

    <owl:ObjectProperty rdf:about="https://personsincontext.org/model#hasCousin">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:label xml:lang="en">hasCousin</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://personsincontext.org/model#hasCousin-in-law -->

    <owl:ObjectProperty rdf:about="https://personsincontext.org/model#hasCousin-in-law">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:label xml:lang="en">hasCousin-in-law</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://personsincontext.org/model#hasDescendant -->

    <owl:ObjectProperty rdf:about="https://personsincontext.org/model#hasDescendant">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:comment xml:lang="en">&quot;hasDescendant is not meant to be used as a property for PersonObservations or PersonReconstructions. It is a superclass of sdo:Children. Since hasAncestor is a owl:TransitiveProperty, this will make the children of your children into your descendants&quot; (https://www.personsincontext.org/model/#hasDescendant)</rdfs:comment>
        <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://personsincontext.org/model#hasDescendant</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">hasDescendant</rdfs:label>
    </owl:ObjectProperty>
    


