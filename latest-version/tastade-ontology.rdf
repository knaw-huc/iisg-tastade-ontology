    <owl:ObjectProperty rdf:about="https://personsincontext.org/model#hasFosterChild">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:label xml:lang="en">hasFosterChild</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://personsincontext.org/model#hasFosterParent -->

    <owl:ObjectProperty rdf:about="https://personsincontext.org/model#hasFosterParent">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:label xml:lang="en">hasFosterParent</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://personsincontext.org/model#hasGodchild -->

    <owl:ObjectProperty rdf:about="https://personsincontext.org/model#hasGodchild">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:label xml:lang="en">hasGodchild</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://personsincontext.org/model#hasGodparent -->

    <owl:ObjectProperty rdf:about="https://personsincontext.org/model#hasGodparent">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:label xml:lang="en">hasGodparent</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://personsincontext.org/model#hasGrandchild -->

    <owl:ObjectProperty rdf:about="https://personsincontext.org/model#hasGrandchild">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:label xml:lang="en">hasGrandchild</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://personsincontext.org/model#hasGrandchild-in-law -->

    <owl:ObjectProperty rdf:about="https://personsincontext.org/model#hasGrandchild-in-law">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:label xml:lang="en">hasGrandchild-in-law</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://personsincontext.org/model#hasGrandparent -->

    <owl:ObjectProperty rdf:about="https://personsincontext.org/model#hasGrandparent">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:label xml:lang="en">hasGrandparent</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://personsincontext.org/model#hasGrandparent-in-law -->

    <owl:ObjectProperty rdf:about="https://personsincontext.org/model#hasGrandparent-in-law">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:label xml:lang="en">hasGrandparent-in-law</rdfs:label>
